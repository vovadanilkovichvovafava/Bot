# Local dev config (Vite). In production these are injected at container start
# via docker-entrypoint.sh as window.__APP_CONFIG__ (see src/shared/config/env.js).
# Use PLACEHOLDER values here — never commit real offer/tracker links or keys.

# Backend API URL (per-deployment)
VITE_API_URL=https://your-backend.example/api/v1

# BkProxy URL for bookmaker integration
VITE_BKPROXY_URL=https://your-bkproxy.example

# Tracking / Postback API URL (per-deployment)
VITE_TRACKING_API=https://your-tracking.example

# Offer URL — affiliate tracker link (DIFFERENT per deployment!)
VITE_OFFER_URL=https://tracker.example/CODE

# Google traffic offer URL — separate campaign for Google Ads traffic
# Users with utm_source=google are routed through this link
VITE_OFFER_URL_GOOGLE=

# Funnel-2/4 offer URL (optional)
VITE_OFFER_URL_F2=

# Traffic source identifier (DIFFERENT per deployment domain!)
VITE_TRAFFIC_SOURCE=example_com

# Extra hosts allowed as bookmaker deeplinks (comma-separated) — open-redirect allowlist
VITE_DEEPLINK_HOSTS=

# Bookmaker config (change per offer/geo — NO BRAND NAMES shown to users)
VITE_BOOKMAKER_NAME=Partner
VITE_BOOKMAKER_LINK=https://your-affiliate-link.example
VITE_BOOKMAKER_BONUS=Welcome Bonus
VITE_BOOKMAKER_PROMO=
VITE_BOOKMAKER_MIN_DEPOSIT=$10

# Web push public key (optional)
VITE_VAPID_PUBLIC_KEY=

# NOTE: the API-Football key is server-side only and is NOT configured here —
# all football data is proxied through the backend.
