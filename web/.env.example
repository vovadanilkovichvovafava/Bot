# API-Football (api-sports.io) key
VITE_API_FOOTBALL_KEY=your-api-football-key-here

# Backend API URL (change for each deployment)
VITE_API_URL=https://appbot-production-152e.up.railway.app/api/v1

# BkProxy URL for bookmaker integration
VITE_BKPROXY_URL=https://bkproxy-production.up.railway.app

# Tracking / Postback API URL (change for each deployment)
VITE_TRACKING_API=https://postbackapi-production.up.railway.app

# Offer URL — tracker link for the affiliate campaign (DIFFERENT per deployment!)
VITE_OFFER_URL=https://siteofficialred.com/KnSQ1M

# Google traffic offer URL — separate Keitaro campaign for Google Ads traffic
# Users with utm_source=google will be routed through this link
VITE_OFFER_URL_GOOGLE=

# Traffic source identifier (DIFFERENT per deployment domain!)
# prescoreai.com → prescoreai_com
# prescore.vip   → prescore_vip
VITE_TRAFFIC_SOURCE=prescoreai_com

# Bookmaker config (change per offer/geo - NO BRAND NAMES to users)
VITE_BOOKMAKER_NAME=Partner
VITE_BOOKMAKER_LINK=https://your-affiliate-link.com
VITE_BOOKMAKER_BONUS=Welcome Bonus
VITE_BOOKMAKER_PROMO=
VITE_BOOKMAKER_MIN_DEPOSIT=$10
