# Server Configuration
PORT=3001

# Bookmaker Partner Info (placeholders — set real values via deployment env)
BOOKMAKER_NAME=Partner
BOOKMAKER_AFFILIATE_ID=your_affiliate_id

# Main API Backend (per-deployment)
MAIN_API_URL=https://your-backend.example/api/v1

# Security — REQUIRED. Internal secret used for server→backend calls and as the
# fallback for postback/admin auth. Use a long random value.
POSTBACK_SECRET=change_me_long_random_secret

# Secret Keitaro must include on its postback URL (&secret=...). Falls back to
# POSTBACK_SECRET if unset.
KEITARO_SECRET=

# Separate credential for admin/debug endpoints (X-Admin-Secret header or ?secret=).
# Falls back to POSTBACK_SECRET if unset — set a DISTINCT value in production.
ADMIN_SECRET=

# Comma-separated browser origins allowed via CORS (empty = same-origin only)
ALLOWED_ORIGINS=

# Number of trusted reverse-proxy hops in front of this server (Cloudflare/Saturn)
TRUST_PROXY_HOPS=1

# Geo-blocking: Countries where bookmaker is blocked (comma-separated ISO codes)
BLOCKED_COUNTRIES=RU,BY,UA,KZ,AZ,AM,GE,MD,KG,TJ,TM,UZ

# Alternative/Mirror Domain for blocked countries
MIRROR_DOMAIN=https://your-mirror.example

# Safe landing page for blocked countries (if no mirror available)
SAFE_LANDING=/blocked
